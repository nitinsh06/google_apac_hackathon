rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The publish contract, in one place. `hasAll` states the required fields
    // explicitly so a missing one reads as a clear denial rather than an
    // evaluation error, and `hasOnly` is what keeps journal content out.
    function validCard(slug) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'slug', 'ownerId', 'displayName', 'title', 'level', 'rarity',
          'score', 'stats', 'topDomains', 'since', 'updatedAt', 'schemaVersion'
        ])
        && data.keys().hasAll([
          'slug', 'ownerId', 'displayName', 'title', 'level', 'rarity',
          'score', 'stats', 'topDomains'
        ])
        && data.slug == slug
        && slug.matches('^[a-z0-9]{6,32}$')
        && data.displayName is string && data.displayName.size() <= 60
        && data.title is string && data.title.size() <= 40
        && data.level is number && data.level >= 1 && data.level <= 10
        && data.rarity in ['common', 'uncommon', 'rare', 'epic', 'legendary']
        && data.score is number && data.score >= 0 && data.score <= 10000000
        && data.topDomains is list && data.topDomains.size() <= 5
        && data.stats.keys().hasOnly(['entries', 'places', 'domains', 'months', 'shifts', 'depth']);
    }

    // Prohibit all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User-isolated document tree. Every path the app touches is named
    // explicitly rather than covered by a `{allSubcollections=**}` wildcard:
    // rules are OR-ed, so a broad `allow write` beside a validated one means
    // the validation never runs. Adding a subcollection means adding a rule.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/reflections/{reflectionId} {
      allow read, write: if isOwner(userId);
    }

    // Appearance preferences, written straight from the browser. Owner-bound
    // like everything else, and shape-checked: the rule names the only three
    // fields and the only legal values rather than trusting the client.
    match /users/{userId}/preferences/appearance {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['theme', 'accent', 'updatedAt'])
        && request.resource.data.theme in ['light', 'dark']
        && request.resource.data.accent in ['blue', 'violet', 'emerald', 'amber', 'rose']
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 32;
    }

    // Per-entry analytics readings, written by the browser from what the
    // extraction endpoint returned. Owner-bound and bounded: the rule caps the
    // field set and the array lengths so a compromised client cannot turn a
    // derived-data collection into unbounded storage.
    match /users/{userId}/insights/{entryId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
             'entryId', 'entryTitle', 'entryCreatedAt', 'category',
             'domains', 'primaryDomain', 'valence', 'energy', 'sentiment',
             'emotions', 'beliefShifts', 'patterns', 'depth', 'summary',
             'extractedAt', 'model', 'schemaVersion'
           ])
        && request.resource.data.entryId == entryId
        && request.resource.data.valence >= -1 && request.resource.data.valence <= 1
        && request.resource.data.energy >= 0 && request.resource.data.energy <= 1
        && request.resource.data.depth >= 0 && request.resource.data.depth <= 1
        && request.resource.data.domains.size() <= 4
        && request.resource.data.emotions.size() <= 4
        && request.resource.data.patterns.size() <= 4
        && request.resource.data.beliefShifts.size() <= 3
        && request.resource.data.summary.size() <= 200
        && request.resource.data.entryTitle.size() <= 120;
    }

    // Monthly retrospectives, one document per calendar month.
    match /users/{userId}/monthlySummaries/{month} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
             'month', 'entryCount', 'headline', 'narrative', 'topDomains',
             'valence', 'energy', 'trend', 'emergingPatterns', 'fadingPatterns',
             'beliefShifts', 'question', 'generatedAt', 'model', 'schemaVersion'
           ])
        && request.resource.data.month == month
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.trend in ['rising', 'falling', 'steady']
        && request.resource.data.headline.size() <= 90
        && request.resource.data.narrative.size() <= 900
        && request.resource.data.question.size() <= 240
        && request.resource.data.topDomains.size() <= 5;
    }

    // Integration settings, including webhook destinations. Owner-only: a
    // webhook URL is a capability to post into someone's channel.
    match /users/{userId}/preferences/integrations {
      allow read, write: if isOwner(userId);
    }

    // Which share link, if any, this user has published. Owner-only; the card
    // itself lives in the public collection below.
    match /users/{userId}/preferences/card {
      allow read, write: if isOwner(userId);
    }

    // ── The one public collection ────────────────────────────────────────
    //
    // A published journal card, readable by anyone holding the link. The field
    // allowlist is the privacy guarantee, not a formality: it is what stops a
    // compromised or modified client from ever placing an entry title, an
    // excerpt or a place name into a world-readable document. Adding a field
    // here means deciding it is safe to publish.
    match /publicCards/{slug} {
      allow read: if true;

      allow create: if isOwner(request.resource.data.ownerId)
        && validCard(slug);

      // Pinning both copies of ownerId stops one user overwriting another's
      // slug, and stops an owner reassigning their card to someone else.
      allow update: if isOwner(resource.data.ownerId)
        && isOwner(request.resource.data.ownerId)
        && validCard(slug);

      allow delete: if isOwner(resource.data.ownerId);
    }
  }

}
