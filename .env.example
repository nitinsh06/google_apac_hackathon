# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional/Required for interactive Google Maps rendering and Places search.
# For zero-cost prototyping without a billing card, obtain a free Maps Demo Key:
# https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_mcp_codeassist_v1_aistudio
# For production, obtain and restrict an API key in Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis/credentials?utm_campaign=gmp_mcp_codeassist_v1_aistudio
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_MAP_ID: Map ID for the Places Map tab. Advanced Markers require one.
# Defaults to "DEMO_MAP_ID" for prototyping; create your own styled map ID for production:
# https://console.cloud.google.com/google/maps-apis/studio/maps?utm_campaign=gmp_mcp_codeassist_v1_aistudio
VITE_GOOGLE_MAPS_MAP_ID=""

# WEBHOOK_BLOCK_PRIVATE_TARGETS: Optional hardening for "Other" webhook destinations.
# Unset (the default), a generic endpoint may point at localhost or a private address,
# which is what you want while developing against a listener on your own machine.
# Set to "true" on a shared or public deployment to refuse any host that resolves to a
# loopback, link-local or RFC1918 address. Discord and Slack are always host-pinned.
WEBHOOK_BLOCK_PRIVATE_TARGETS=""

# RESEND_API_KEY: Required for the Email notification channel. Server-side only —
# never expose this to the browser and never prefix it with VITE_.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=""

# RESEND_FROM: Verified sender for notification email, e.g. "ReflectAI <hello@yourdomain.com>".
# Defaults to Resend's shared onboarding@resend.dev sender, which only delivers to the
# address that owns the Resend account — fine for testing, not for real users.
RESEND_FROM=""

# ─── Analytics background worker ──────────────────────────────────────────
# Set on Cloud Run only. When "true", an Eventarc trigger calls
# /api/tasks/reflection-written on every reflection write and the server does
# the extraction; the browser stops queueing its own so nothing is billed twice.
# Leave unset locally — the browser-side debounce keeps working.
ANALYTICS_WORKER_ENABLED=""

# The service account Eventarc invokes the service with. The worker refuses any
# delivery not signed by exactly this principal.
EVENTARC_SERVICE_ACCOUNT=""

# The audience Eventarc mints its OIDC token for — your Cloud Run service URL.
# Pinning it stops a token issued for another service being replayed here.
EVENTARC_AUDIENCE=""
